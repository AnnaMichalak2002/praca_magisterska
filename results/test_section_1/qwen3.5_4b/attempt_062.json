  "raw_output": "{\n  \"exercise_type\": \"CEFR English Placement Test\",\n  \"section_id\": 1,\n  \"section_title\": \"Grammar and Vocabulary (A1-A2)\",\n  \"cefr_range\": \"A1-A2\",\n  \"questions\": [\n    {\n      \"question_number\": 1,\n      \"question\": \"Which sentence is correct?\",\n      \"options\": [\n        \"She don't like coffee.\",\n        \"She doesn't like coffee.\",\n        \"She isn't like coffee.\",\n        \"She not like coffee.\"\n      ],\n      \"answer\": \"She doesn't like coffee.\"\n    },\n    {\n      \"question_number\": 2,\n      \"question\": \"Complete the sentence: I ______ to the cinema last night.\",\n      \"options\": [\n        \"go\",\n        \"went\",\n        \"gone\",\n        \"going\"\n      ],\n      \"answer\": \"went\"\n    },\n    {\n      \"question_number\": 3,\n      \"question\": \"Choose the correct pronoun to complete the sentence: ______ book is on the table.\",\n      \"options\": [\n        \"he\",\n        \"him\",\n        \"his\",\n        \"he's\"\n      ],\n      \"answer\": \"his\"\n    },\n    {\n      \"question_number\": 4,\n      \"question\": \"Which sentence uses the article correctly?\",\n      \"options\": [\n        \"I have an apple and a banana.\",\n        \"I have a apple and an banana.\",\n        \"I have apple and banana.\",\n        \"I have an apple and banana.\"\n      ],\n      \"answer\": \"I have an apple and a banana.\"\n    },\n    {\n      \"question_number\": 5,\n      \"question\": \"Select the correct preposition: She is interested ______ learning French.\",\n      \"options\": [\n        \"in\",\n        \"on\",\n        \"at\",\n        \"for\"\n      ],\n      \"answer\": \"in\"\n    },\n    {\n      \"question_number\": 6,\n      \"question\": \"Which verb form is correct for this sentence? \"We usually ______ breakfast at 7 AM.\",\n      \"options\": [\n        \"eat\",\n        \"eats\",\n        \"eating\",\n        \"ate\"\n      ],\n      \"answer\": \"eat\"\n    },\n    {\n      \"question_number\": 7,\n      \"question\": \"Complete the sentence with the correct word: There are only ______ seats left.\",\n      \"options\": [\n        \"few\",\n        \"little\",\n        \"a few\",\n        \"a little\"\n      ],\n      \"answer\": \"a few\"\n    },\n    {\n      \"question_number\": 8,\n      \"question\": \"Which sentence is grammatically correct?\",\n      \"options\": [\n        \"She have a new car.\",\n        \"She has a new car.\",\n        \"She is having a new car.\",\n        \"She had a new car.\"\n      ],\n      \"answer\": \"She has a new car.\"\n    },\n    {\n      \"question_number\": 9,\n      \"question\": \"Choose the correct word to complete the sentence: I am looking ______ my keys.\",\n      \"options\": [\n        \"for\",\n        \"at\",\n        \"in\",\n        \"on\"\n      ],\n      \"answer\": \"for\"\n    },\n    {\n      \"question_number\": 10,\n      \"question\": \"Which sentence describes a habit?\",\n      \"options\": [\n        \"I am watching TV right now.\",\n        \"I watched TV yesterday.\",\n        \"I watch TV every evening.\",\n        \"I have watched TV many times.\"\n      ],\n      \"answer\": \"I watch TV every evening.\"\n    }\n  ]\n}",
