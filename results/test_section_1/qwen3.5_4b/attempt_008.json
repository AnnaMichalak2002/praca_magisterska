  "raw_output": "{\n  \"exercise_type\": \"CEFR English Placement Test\",\n  \"section_id\": 1,\n  \"section_title\": \"Grammar and Vocabulary (A1-A2)\",\n  \"cefr_range\": \"A1-A2\",\n  \"questions\": [\n    {\n      \"question_number\": 1,\n      \"question\": \"Which sentence is correct?\",\n      \"options\": [\n        \"She don't like coffee.\",\n        \"She doesn't like coffee.\",\n        \"She not like coffee.\",\n        \"She isn't like coffee.\"\n      ],\n      \"answer\": \"She doesn't like coffee.\"\n    },\n    {\n      \"question_number\": 2,\n      \"question\": \"Choose the correct form of the verb in the Present Simple tense.\",\n      \"options\": [\n        \"He go to school every day.\",\n        \"He goes to school every day.\",\n        \"He going to school every day.\",\n        \"He goed to school every day.\"\n      ],\n      \"answer\": \"He goes to school every day.\"\n    },\n    {\n      \"question_number\": 3,\n      \"question\": \"Which pronoun fits the sentence: \\\"______ is my brother.\\\",\n      \"options\": [\n        \"This\",\n        \"That\",\n        \"These\",\n        \"Those\"\n      ],\n      \"answer\": \"This\"\n    },\n    {\n      \"question_number\": 4,\n      \"question\": \"Select the correct article to complete the sentence: \\\"______ cat is sleeping on the sofa.\\\",\n      \"options\": [\n        \"a\",\n        \"an\",\n        \"the\",\n        \"two\"\n      ],\n      \"answer\": \"the\"\n    },\n    {\n      \"question_number\": 5,\n      \"question\": \"Which preposition is correct for time?\",\n      \"options\": [\n        \"in the morning\",\n        \"on the morning\",\n        \"at the morning\",\n        \"during the morning\"\n      ],\n      \"answer\": \"in the morning\"\n    },\n    {\n      \"question_number\": 6,\n      \"question\": \"Choose the correct Past Simple form of the verb 'to be'.\",\n      \"options\": [\n        \"I was\",\n        \"I am\",\n        \"I were\",\n        \"I had\"\n      ],\n      \"answer\": \"I was\"\n    },\n    {\n      \"question_number\": 7,\n      \"question\": \"Which sentence uses the Past Simple correctly?\",\n      \"options\": [\n        \"Yesterday, I go to the park.\",\n        \"Yesterday, I went to the park.\",\n        \"Yesterday, I going to the park.\",\n        \"Yesterday, I have went to the park.\"\n      ],\n      \"answer\": \"Yesterday, I went to the park.\"\n    },\n    {\n      \"question_number\": 8,\n      \"question\": \"Complete the sentence: \\\"She is interested ______ learning French.\\\",\n      \"options\": [\n        \"in\",\n        \"at\",\n        \"on\",\n        \"for\"\n      ],\n      \"answer\": \"in\"\n    },\n    {\n      \"question_number\": 9,\n      \"question\": \"Which verb is used correctly with 'to have'?\",\n      \"options\": [\n        \"I have a car.\",\n        \"I have two cars.\",\n        \"I have a car and a bike.\",\n        \"All of the above\"\n      ],\n      \"answer\": \"All of the above\"\n    },\n    {\n      \"question_number\": 10,\n      \"question\": \"Choose the correct sentence about daily routine.\",\n      \"options\": [\n        \"I wake up at seven o'clock.\",\n        \"I wake up at seven o'clocks.\",\n        \"I wakes up at seven o'clock.\",\n        \"I waking up at seven o'clock.\"\n      ],\n      \"answer\": \"I wake up at seven o'clock.\"\n    }\n  ]\n}",
