  "raw_output": "{\n  \"exercis_typ\": \"CEFR Englis_Placement Test\",\n  \"section_id\": 1,\n  \"section_title\": \"Grammar and Vocabulary (A1-A2)\",\n  \"cefr_range\": \"A1-A2\",\n  \"questions\": [\n    {\n      \"question_number\": 1,\n      \"question\": \"It's raining. What will we do?\",\\n\n      \"options\": [\"A. Go home.\", \"B. We go home.\", \"C. Let's go home.\", \"D. To go home.\"],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 2,\n      \"question\": \"She always eats pizza on Sunday.\\nWhat is true about her?\",\\n\n      \"options\": [\"A. She never eats pizza.\", \"B. She only eats pizza on Saturdays.\", \"C. Pizza is her favourite food.\", \"D. She does not like pizza.\"],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 3,\n      \"question\": \"It was sunny yesterday.\\nWhat is the correct form of 'was'?\",\\n\n      \"options\": [\"A. were\", \"B. had been\", \"C. was not\", \"D. being.\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 4,\n      \"question\": \"They have a cat in the house.\\nWhat is missing from this sentence?\",\\n\n      \"options\": [\"A. A\", \"B. An\", \"C. The\", \"D. No article needed.\"],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 5,\n      \"question\": \"It's my turn.\\nWhat pronoun is used?\",\\n\n      \"options\": [\"A. My\", \"B. Its\", \"C. His\", \"D. Her.\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 6,\n      \"question\": \"She used to live in London.\\nWhat is the correct form of 'used'?\",\\n\n      \"options\": [\"A. was\", \"B. had been\", \"C. has been\", \"D. were.\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 7,\n      \"question\": \"It's time to go home.\\nWhat preposition is used?\",\\n\n      \"options\": [\"A. On\", \"B. To\", \"C. In\", \"D. For.\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 8,\n      \"question\": \"She can swim very well.\\nWhat is the correct form of 'can'?\",\\n\n      \"options\": [\"A. could\", \"B. may\", \"C. must\", \"D. shall.\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 9,\n      \"question\": \"I have two books and three pencils.\\nWhat is the correct form of 'have'?\",\\n\n      \"options\": [\"A. had\", \"B. has been\", \"C. having\", \"D. have.\"],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 10,\n      \"question\": \"It's time to finish the work.\\nWhat is missing from this sentence?\",\\n\n      \"options\": [\"A. To\", \"B. In\", \"C. With\", \"D. No preposition needed.\"],\n      \"answer\": \"A\"\n    }\n  ]\n}",
