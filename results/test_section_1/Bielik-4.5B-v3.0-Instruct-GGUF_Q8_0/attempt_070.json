  "raw_output": "{\n  \"exercis_type\": \"CEFR English Placement Test\",\n  \"section_id\": 1,\n  \"section_title\": \"Grammar and Vocabulary (A1-A2)\",\n  \"cefr_range\": \"A1-A2\",\n  \"questions\": [\n    {\n      \"question_number\": 1,\n      \"question\": \"It's raining. What will people do?\",\\n\\n**Options:**\\nA) They are going to swim.\\nB) They should take an umbrella.\\nC) It is a good time for hiking.\\nD) People usually enjoy rain.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 2,\n      \"question\": \"I **have** a new book.\\n\\n**Options:**\\nA) I have got.\\nB) It is mine.\\nC) I am having.\\nD) That's nice.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 3,\n      \"question\": \"She **likes** ice cream.\\n\\n**Options:**\\nA) He is a good friend.\\nB) They are her brothers.\\nC) She enjoys it.\\nD) I don't know why.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 4,\n      \"question\": \"I went **to** the store yesterday.\\n\\n**Options:**\\nA) In a car.\\nB) On foot.\\nC) The store is closed now.\\nD) I bought some fruit.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 5,\n      \"question\": \"They **played** football last weekend.\\n\\n**Options:**\\nA) They are playing now.\\nB) It was a beautiful day.\\nC) Their friends came over.\\nD) I don't remember.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 6,\n      \"question\": \"I **see** you.\\n\\n**Options:**\\nA) I don't know what to do.\\nB) He is a good friend.\\nC) You look happy.\\nD) We have nothing in common.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 7,\n      \"question\": \"I **have** a book.\\n\\n**Options:**\\nA) He is not here.\\nB) I am reading it now.\\nC) It's very interesting.\\nD) We need more time.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 8,\n      \"question\": \"She **likes** apples.\\n\\n**Options:**\\nA) I don't like them.\\nB) They are red and round.\\nC) She eats fruit every day.\\nD) That's not true.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 9,\n      \"question\": \"I **go** to school every day.\\n\\n**Options:**\\nA) I don't go there often.\\nB) It is very far from here.\\nC) School starts at nine in the morning.\\nD) My friends and I have lunch together.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 10,\n      \"question\": \"We **watch** TV in the evening.\\n\\n**Options:**\\nA) I don't watch it often.\\nB) They are good friends.\\nC) It is very interesting.\\nD) We usually have dinner before.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"A\"\n    }\n  ]\n}",
