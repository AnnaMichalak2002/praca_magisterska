lace \\\"it\\\"?\\n\\n\\\"It rained yesterday. It was very cold.\\\"\",\n      \"options\": [\n        \"A) He.\",\n        \"B) She.\",\n        \"C) They.\",\n        \"D) It.\"\n      ],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 7,\n      \"question\": \"Which verb form is used in the sentence: \\\"We will be watching TV.\\\"?\",\\n\\n\"Choose the correct type of verb.\",\n      \"options\": [\n        \"A) Present Simple.\",\n        \"B) Past Continuous.\",\n        \"C) Present Perfect.\",\n        \"D) Future Continuous.\"\n      ],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 8,\n      \"question\": \"Which preposition is correct in the sentence: \\\"I have a car.\\\"?\",\\n\\n\"Choose the right preposition:\",\n      \"options\": [\n        \"A) In.\",\n        \"B) On.\",\n        \"C) At.\",\n        \"D) Have.\"\n      ],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 9,\n      \"question\": \"Which verb form is used in the sentence: \\\"They are playing football.\\\"?\",\\n\\n\"Choose the correct type of verb.\",\n      \"options\": [\n        \"A) Present Simple.\",\n        \"B) Past Continuous.\",\n        \"C) Present Perfect.\",\n        \"D) Future Continuous.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 10,\n      \"question\": \"Which pronoun should replace \\\"this\\\"?\\n\\n\\\"This book is very interesting. This movie was amazing.\\\"\",\n      \"options\": [\n        \"A) He.\",\n        \"B) She.\",\n        \"C) They.\",\n        \"D) It.\"\n      ],\n      \"answer\": \"D\"\n    }\n}",
