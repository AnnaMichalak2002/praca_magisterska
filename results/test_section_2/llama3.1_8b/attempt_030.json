ion_number\": 17,\n      \"question\": \"The traffic in this city is terrible. It takes me at least an hour to get to work.\",\n      \"options\": [\"takes less time\", \"takes more time\", \"isn't a problem\", \"has improved\"],\n      \"answer\": \"takes more time\"\n    },\n    {\n      \"question_number\": 18,\n      \"question\": \"If it rains tomorrow, we'll have to cancel the picnic. Otherwise, let's go to the park.\",\n      \"options\": [\"will go to the beach\", \"won't go to the park\", \"had gone to the park\", \"will go to the cinema\"],\n      \"answer\": \"otherwise\"\n    },\n    {\n      \"question_number\": 19,\n      \"question\": \"I've been studying English for three years now. I'm feeling more confident in my speaking skills.\",\n      \"options\": [\"haven't studied\", \"have studied\", \"had studied\", \"will study\"],\n      \"answer\": \"have studied\"\n    },\n    {\n      \"question_number\": 20,\n      \"question\": \"This restaurant is famous for its delicious food and excellent service. It's a great place to take your family.\",\n      \"options\": [\"isn't famous\", \"has good food but bad service\", \"is expensive\", \"is near my house\"],\n      \"answer\": \"it's a great place\"\n    }\n  ]\n}",
