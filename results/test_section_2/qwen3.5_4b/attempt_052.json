  "raw_output": "{\n  \"exercise_type\": \"CEFR English Placement Test\",\n  \"section_id\": 2,\n  \"section_title\": \"Grammar and Vocabulary (B1)\",\n  \"cefr_range\": \"B1\",\n  \"questions\": [\n    {\n      \"question_number\": 11,\n      \"question\": \"Which sentence uses the present perfect correctly to describe an action that has no specific time mentioned?\",\n      \"options\": [\n        \"I have lived here since 2010.\",\n        \"I have lived here for five years.\",\n        \"I lived here for five years.\",\n        \"I live here for five years.\"\n      ],\n      \"answer\": \"I have lived here for five years.\"\n    },\n    {\n      \"question_number\": 12,\n      \"question\": \"Choose the correct comparative form of the adjective 'happy'.\",\n      \"options\": [\n        \"happier\",\n        \"more happy\",\n        \"happyest\",\n        \"most happy\"\n      ],\n      \"answer\": \"happier\"\n    },\n    {\n      \"question_number\": 13,\n      \"question\": \"Which sentence correctly uses a first conditional to express a future possibility?\",\n      \"options\": [\n        \"If it rains, we will stay at home.\",\n        \"If it rained, we would stay at home.\",\n        \"If it rains, we will stay home.\",\n        \"If it rained, we will stay at home.\"\n      ],\n      \"answer\": \"If it rains, we will stay at home.\"\n    },\n    {\n      \"question_number\": 14,\n      \"question\": \"Select the sentence that correctly uses a gerund as the subject.\",\n      \"options\": [\n        \"Swimming is good exercise.\",\n        \"To swim is good exercise.\",\n        \"Swim is good exercise.\",\n        \"Swam is good exercise.\"\n      ],\n      \"answer\": \"Swimming is good exercise.\"\n    },\n    {\n      \"question_number\": 15,\n      \"question\": \"Which modal verb is best used to give advice?\",\n      \"options\": [\n        \"should\",\n        \"must\",\n        \"can\",\n        \"might\"\n      ],\n      \"answer\": \"should\"\n    },\n    {\n      \"question_number\": 16,\n      \"question\": \"Complete the sentence with the correct past continuous form: \"While I ______ dinner, the phone rang.\"\",\n      \"options\": [\n        \"was cooking\",\n        \"cook\",\n        \"cooked\",\n        \"am cooking\"\n      ],\n      \"answer\": \"was cooking\"\n    },\n    {\n      \"question_number\": 17,\n      \"question\": \"Which sentence uses 'linker' words correctly to show contrast?\",\n      \"options\": [\n        \"Although she is tired, she feels energetic.\",\n        \"Because she is tired, she feels energetic.\",\n        \"Since she is tired, she feels energetic.\",\n        \"While she is tired, she feels energetic.\"\n      ],\n      \"answer\": \"Although she is tired, she feels energetic.\"\n    },\n    {\n      \"question_number\": 18,\n      \"question\": \"Choose the correct sentence using the infinitive after 'want'.\",\n      \"options\": [\n        \"I want go to the cinema.\",\n        \"I want going to the cinema.\",\n        \"I want to go to the cinema.\",\n        \"I wanted to go to the cinema.\"\n      ],\n      \"answer\": \"I want to go to the cinema.\"\n    },\n    {\n      \"question_number\": 19,\n      \"question\": \"Identify the correct superlative form of the adjective 'good'.\",\n      \"options\": [\n        \"gooder\",\n        \"more good\",\n        \"best\",\n        \"most good\"\n      ],\n      \"answer\": \"best\"\n    },\n    {\n      \"question_number\": 20,\n      \"question\": \"Which sentence correctly uses the past perfect to show an action completed before another past action?\",\n      \"options\": [\n        \"I had finished my homework before dinner.\",\n        \"I finished my homework before dinner.\",\n        \"I have finished my homework before dinner.\",\n        \"I had finished my homework after dinner.\"\n      ],\n      \"answer\": \"I had finished my homework before dinner.\"\n    }\n  ]\n}",
