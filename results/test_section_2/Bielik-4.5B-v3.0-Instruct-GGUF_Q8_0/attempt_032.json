  "raw_output": "{\n  \"exercis_typ\": \"CEFR Englis_Placement Test\",\n  \"section_id\": 2,\n  \"section_title\": \"Grammar and Vocabulary (B1)\",\n  \"cefr_range\": \"B1\",\n  \"questions\": [\n    {\n      \"question_number\": 11,\n      \"question\": \"Which past tense is used for an action that happened at a specific time in the past?\",\n      \"options\": [\n        \"Past Simple\",\n        \"Present Perfect\",\n        \"Past Continuous\",\n        \"Past Perfect\"\n      ],\n      \"answer\": \"Past Simple\"\n    },\n    {\n      \"question_number\": 12,\n      \"question\": \"What is the correct form of 'have been' for the present perfect continuous tense?\",\n      \"options\": [\n        \"haven't been\",\n        \"have not been\",\n        \"have been\",\n        \"had been\"\n      ],\n      \"answer\": \"have been\"\n    },\n    {\n      \"question_number\": 13,\n      \"question\": \"Which form is used to express a comparative of adjectives ending in -al?\",\n      \"options\": [\n        \"more\",\n        \"less\",\n        \"another\",\n        \"compared\"\n      ],\n      \"answer\": \"more\"\n    },\n    {\n      \"question_number\": 14,\n      \"question\": \"Which modal does not use 'have' before the verb?\",\n      \"options\": [\n        \"can\",\n        \"should\",\n        \"may\",\n        \"must\"\n      ],\n      \"answer\": \"can\"\n    },\n    {\n      \"question_number\": 15,\n      \"question\": \"Which of these is a common gerund used as a noun?\",\n      \"options\": [\n        \"cooking\",\n        \"cooks\",\n        \"cooked\",\n        \"to cook\"\n      ],\n      \"answer\": \"cooking\"\n    },\n    {\n      \"question_number\": 16,\n      \"question\": \"Which of these is a correct usage of 'unless'?\",\n      \"options\": [\n        \"I will come unless you invite me.\",\n        \"I will go to school if it rains.\",\n        \"She went home because the weather was bad.\",\n        \"They stayed at the party until everyone left.\"\n      ],\n      \"answer\": \"I will come unless you invite me.\"\n    },\n    {\n      \"question_number\": 17,\n      \"question\": \"Which of these is a correct usage of 'after' with past tenses?\",\n      \"options\": [\n        \"I saw him after I finished my work.\",\n        \"She left the party before everyone arrived.\",\n        \"They watched a movie and then had dinner.\",\n        \"I saw her at school because she called me.\"\n      ],\n      \"answer\": \"I saw him after I finished my work.\"\n    },\n    {\n      \"question_number\": 18,\n      \"question\": \"Which of these is a correct usage of 'because' with past perfect tenses?\",\n      \"options\": [\n        \"I have never seen such beautiful flowers.\",\n        \"They had already left when I arrived.\",\n        \"She was tired so she went to sleep.\",\n        \"We were late because the traffic was heavy.\"\n      ],\n      \"answer\": \"They had already left when I arrived.\"\n    },\n    {\n      \"question_number\": 19,\n      \"question\": \"Which of these is a correct usage of 'or' with conditionals?\",\n      \"options\": [\n        \"If it rains, I will stay at home or go to work.\",\n        \"She would have called you if she had known your number.\",\n        \"They went for a walk and then they sat down.\",\n        \"If I was rich, I would buy a house or travel around the world.\"\n      ],\n      \"answer\": \"She would have called you if she had known your number.\"\n    },\n    {\n      \"question_number\": 20,\n      \"question\": \"Which of these is a correct usage of 'however' with adjectives?\",\n      \"options\": [\n        \"The book was interesting and however, it also made me tired.\",\n        \"I am very happy because I passed my exams or unhappy that I didn't get the job.\",\n        \"She is smart but she is not as good at sports however.\",\n        \"They are friends despite their differences.\"\n      ],\n      \"answer\": \"I am very happy because