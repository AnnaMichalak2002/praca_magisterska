  "raw_output": "{\n  \"exercis_typ\": \"CEFR English Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is an example of reported speech? \\nA) She said she would come. \\\\\\\"She said that she was going to come.\\\\\\\"\",\n      \"options\": [\n        \"A) She said she would come.\",\n        \"B) He told me he had finished his homework.\",\n        \"C) They were talking about the movie.\",\n        \"D) The cat scratched the door.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Choose the correct form of the passive voice for the sentence. \\n\\\"The book was written by John.\\\"\",\n      \"options\": [\n        \"A) Who wrote the book?\",\n        \"B) The book has been written by John.\",\n        \"C) By whom was the book written?\",\n        \"D) The book is being written.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Which advanced conditional sentence is grammatically correct? \\n\\\"If I had studied harder, I would not have failed the exam.\\\"\",\n      \"options\": [\n        \"A) If you had studied hard, you would not have passed.\",\n        \"B) Had I studied less, I would pass the exam.\",\n        \"C) If I had studied more, I would have succeeded.\",\n        \"D) Studying harder, I would not fail.\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which discourse marker is appropriate to connect the sentences? \\n\\\"I think it will rain tomorrow. \\\\\\\"Sadly, I agree with you.\\\\\\\"\",\n      \"options\": [\n        \"A) In other words.\",\n        \"B) However.\",\n        \"C) Therefore.\",\n        \"D) Nevertheless.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which collocation is correct? \\n\\\"The team decided to give up on the project.\\\"\",\n      \"options\": [\n        \"A) The team gave away.\",\n        \"B) The team gave in.\",\n        \"C) The team gave up on.\",\n        \"D) The team gave off.\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which dependent preposition is correct in the sentence? \\n\\\"I don't know where to find answers.\\\"\",\n      \"options\": [\n        \"A) for.\",\n        \"B) at.\",\n        \"C) in.\",\n        \"D) on.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which precise lexical choice is appropriate? \\n\\\"The cat sat on the table.\\\"\",\n      \"options\": [\n        \"A) The dog lay.\",\n        \"B) The bird perched.\",\n        \"C) The cat slept on the floor.\",\n        \"D) The mouse jumped.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which grammatical structure is correct? \\n\\\"It was decided that the meeting should be postponed.\\\"\",\n      \"options\": [\n        \"A) It was decided to postpone.\",\n        \"B) The meeting was decided to be postponed.\",\n        \"C) The meeting should have been postponed.\",\n        \"D) It was decided that the meeting be postponed.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Which reported speech is grammatically correct? \\n\\\"She said she was going to the party.\\\"\",\n      \"options\": [\n        \"A) She said that he went.\",\n        \"B) He said that she will be there.\",\n        \"C) She said that she was going to the party.\",\n        \"D) They said that they were leaving.\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which discourse marker is appropriate to connect the 