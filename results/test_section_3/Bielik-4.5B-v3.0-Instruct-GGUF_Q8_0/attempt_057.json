  "raw_output": "{\n  \"exercis_typ\": \"CEFR Englis_Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is an example of reported speech? \\nA) I think she said 'I'm going to the park.'\\nB) She says that she will visit her grandparents next week.\\nC) He claims he has finished his homework already.\\nD) We were told that a meeting is scheduled for Friday.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Choose the correct form of the passive voice for the sentence: \\n\\\"The company has been built by John and his team.\\\"\\nA) The company is being built by John and his team.\\nB) The company was built by John's team.\\nC) By John and his team, the company has been built.\\nD) John and his team have built the company.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Which of the following conditional sentences is incorrect?\\nA) If it were to rain, we would stay at home.\\nB) Had she known about the meeting, she would have been there.\\nC) She cannot speak French because he does not understand English.\\nD) He could play tennis if he had time.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which of the following discourse markers is most appropriate to introduce a new idea?\\nA) however\\nB) therefore\\nC) and\\nD) but\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which collocation is incorrect?\\nA) a breakfast table\\nB) an afternoon tea\\nC) a morning coffee\\nD) a night dinner\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which dependent prepositional phrase is incorrect?\\nA) after which he was fired\\nB) because of whose actions I am upset\\nC) since when she has been working here\\nD) as much as possible\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which of the following phrases is a precise lexical choice?\\nA) I'm feeling quite tired.\\nB) He has been working hard all week.\\nC) The book was very interesting.\\nD) It took me hours to finish the project.\",\n    \n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which of the following sentences uses a dependent prepositional phrase?\\nA) She likes to read books.\\nB) Because I was late, I missed the train.\\nC) The cat jumped over the fence.\\nD) When she arrived at the station, she saw her friend waiting.\",\n    \n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Which of the following sentences uses a misplaced modifier?\\nA) Having finished his homework, he went to bed.\\nB) The book that I borrowed from the library is interesting.\\nC) She was surprised by her success in the competition.\\nD) He has been working on this project for weeks.\",\n    \n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which of the following constructions is incorrect?\\nA) If you don't mind, could you pass me the salt?\\nB) It was decided that we should go for a walk.\\nC) She said she would come if he arrived early.\\nD) We will try to finish this task by Friday.\"\n    \n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\"