  "raw_output": "{\n  \"exercis_typ\": \"CEFR Englis_Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is a correct translation for 'It was said that he had finished his work'?\",\n      \"options\": [\n        \"A) He has finished his work was said.\",\n        \"B) It was said that he had finished his work.\",\n        \"C) Had he finished his work, it was said.\",\n        \"D) He had finished his work is what was said.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Choose the correct form of 'have been' in the following sentence: 'The book has not yet been read by anyone.'\",\n      \"options\": [\n        \"A) have begun\",\n        \"B) had been\",\n        \"C) been\",\n        \"D) was read\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Which of the following sentences uses the passive voice correctly?\",\n      \"options\": [\n        \"A) The cake was baked by me.\",\n        \"B) I have been told that she has left for Paris.\",\n        \"C) She is being looked after by her sister.\",\n        \"D) The ball was thrown into the tree.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which advanced conditional phrase is appropriate for the following situation: 'If I had studied harder, I would have passed the exam.'\",\n      \"options\": [\n        \"A) Present Simple + would have done.\",\n        \"B) Past Perfect + had done.\",\n        \"C) Present Perfect + were to do.\",\n        \"D) Future Perfect + will be.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Choose the correct word to complete the sentence: 'It is important that we consider all possible outcomes.'\",\n      \"options\": [\n        \"A) examine.\",\n        \"B) analyse.\",\n        \"C) evaluate.\",\n        \"D) contemplate.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which of the following phrases is an appropriate discourse marker to connect two ideas in a sentence?\",\n      \"options\": [\n        \"A) As far as I know.\",\n        \"B) In other words,\",\n        \"C) However much you try.\",\n        \"D) But in fact.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which collocation is correct in the context 'I need to finish my report by next week.'?\",\n      \"options\": [\n        \"A) report off.\",\n        \"B) report up.\",\n        \"C) report out.\",\n        \"D) report in.\"\n      ],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which dependent preposition is most appropriate for the phrase 'because of which'?\",\n      \"options\": [\n        \"A) that.\",\n        \"B) what.\",\n        \"C) why.\",\n        \"D) which.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Choose the most precise lexical choice for 'It is crucial that we conduct a thorough investigation.'\",\n      \"options\": [\n        \"A) necessary.\",\n        \"B) important.\",\n        \"C) vital.\",\n        \"D) essential.\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which of the following sentences is an example of reported speech using the correct tense?\",\n      \"options\": [\n        \"A) She said she was going to the cinema.\",\n        \"B) He claimed that he had finished his work already.\",\n        \"C) They stated that they would be there by evening.\",\n        \"D) We were informed that the meeting was cancelled.\"\n      ],\n      \"answer\": \"B\