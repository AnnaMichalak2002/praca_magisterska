  "raw_output": "{\n  \"exercis_typ\": \"CEFR Englis_Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammmar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is an example of reported speech? \\nA) She said she was tired.\\nB) He told me he would be late.\\nC) They suggested we should stay.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"What is the correct form of the passive voice for 'The book was written by Jane Austen'? \\nA) Who wrote the book?\\nB) The book was written.\\nC) Books were written by Jane Austen.\\nD) By whom did they write the book?\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Choose the appropriate conditional form for 'If I had known about it, I would have come.' \\nA) Present Simple\\nB) Past Perfect\\nC) Present Perfect\\nD]\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which of the following uses a discourse marker appropriately? \\nA) I went to the shop. Therefore, I bought some milk.\\nB) The rain was heavy. Moreover, it continued all day.\\nC) She is tall and she's beautiful. Thus, they fell in love.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which collocation is correct? \\nA) take charge of\\nB) handle over\\nC) manage away\\nD]\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which dependent preposition is used correctly in 'It's important that we complete the project on time.'? \\nA) for\\nB) to\\nC) with\\nD]\",\