  "raw_output": "{\n  \"exercis_typ\": \"CEFR Englis_Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is an example of reported speech?\",\n      \"options\": [\n        \"A) I think he said it was raining.\",\n        \"B) He says that he will be here soon.\",\n        \"C) She told me she's going out.\",\n        \"D) They are planning a trip.\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Which form of the passive voice is correct for this sentence?\",\n      \"options\": [\n        \"A) The book was written by John.\",\n        \"B) John wrote the book.\",\n        \"C) The book is being read now.\",\n        \"D) They are fixed their car.\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Choose the correct advanced conditional to express a hypothetical situation.\",\n      \"options\": [\n        \"A) If it had rained, we would have stayed home.\",\n        \"B) When she was here, he went to the store.\",\n        \"C) She will be finished her project by tomorrow.\",\n        \"D) If you had called earlier, they would have been ready.\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which discourse marker is appropriate to introduce a new point?\",\n      \"options\": [\n        \"A) However.\",\n        \"B) Because.\",\n        \"C) But.\",\n        \"D) In addition.\"],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which collocation is correct?\",\n      \"options\": [\n        \"A) Look after your health.\",\n        \"B) Take care of myself.\",\n        \"C) Give up on the exam.\",\n        \"D) Put away your books.\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which dependent preposition is correct in the sentence?\",\n      \"options\": [\n        \"A) I am waiting for her.\",\n        \"B) She lives near me.\",\n        \"C) They are playing football with the kids.\",\n        \"D) We have a conversation about it.\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which precise lexical choice is appropriate?\",\n      \"options\": [\n        \"A) He has a conference call.\",\n        \"B) She had an interview yesterday.\",\n        \"C) I am going to the cinema.\",\n        \"D) They are attending a meeting.\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which form of the past perfect continuous is correct?\",\n      \"options\": [\n        \"A) I had been working all morning.\",\n        \"B) She has finished her homework.\",\n        \"C) They are studying for the exam.\",\n        \"D) He will have arrived by now.\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Which adjectival phrase is correct?\",\n      \"options\": [\n        \"A) The book that I read was interesting.\",\n        \"B) The car which she owns is old.\",\n        \"C) The man who he saw last week is tall.\",\n        \"D) The city where they live has a lot of traffic.\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which verb tense is used in the sentence?\",\n      \"options\": [\n        \"A) Present continuous.\",\n        \"B) Past perfect.\"\n        \"C) Present perfect.\"\n        \"D) Future perfect.\"],\n      \"answer\": \"A\"\n    }\n  ]\n}",
