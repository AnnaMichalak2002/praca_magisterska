  "raw_output": "{\n  \"exercis_typ\": \"CEFR English Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is an example of reported speech? \\nA) She said she would come. \\nB) He told her that he was tired.\",\n      \"options\": [\n        \"A) She said she would come.\",\n        \"B) He told her that he was tired.\",\n        \"C) They asked if I could help them.\",\n        \"D) We decided to go out for dinner.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Choose the correct form of the passive voice for the following: \\nThe book was written by John.\"\n      \"options\": [\n        \"A) The book has been written by John.\",\n        \"B) By John, the book was written.\",\n        \"C) Written by John, the book is.\",\n        \"D) The book has been written in John.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Which of the following conditionals is used to express a hypothetical situation? \\nA) If it rains, we will stay at home. \\nB) When she was younger, she played tennis.\",\n      \"options\": [\n        \"A) If it rains, we will stay at home.\",\n        \"B) When she was younger, she played tennis.\",\n        \"C) After he finished his work, he went to bed.\",\n        \"D) Because the weather is bad, they decided not to go out.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which discourse marker best connects the two sentences? \\nIt was decided that we should stay home. \\nWe spent the evening watching TV.\"\n      \"options\": [\n        \"A) However.\",\n        \"B) Moreover.\",\n        \"C) Therefore.\",\n        \"D) On the other hand.\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n    