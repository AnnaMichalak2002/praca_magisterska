  "raw_output": "{\n  \"exercis_typ\": \"CEFR English Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is a correct translation for 'It was suggested that we should apply for the job'?\",\n      \"options\": [\n        \"A) It was said that I would be applying.\",\n        \"B) They were asked to apply, but they didn't agree.\",\n        \"C) Suggested we should apply for the job was it that I would be doing.\",\n        \"D) It was suggested that we should apply for the job.\"\n      ],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Which sentence is in the passive voice?\",\n      \"options\": [\n        \"A) She wrote an email to her friend.\",\n        \"B) The book was read by many people.\",\n        \"C) They went out for a walk.\",\n        \"D) I finished my homework.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Which of the following is an advanced conditional used to express a hypothetical situation?\",\n      \"options\": [\n        \"A) If she had studied harder, she would have passed.\",\n        \"B) She will be here if it rains.\",\n        \"C) We could go to the park if we wanted.\",\n        \"D) If he had known, he would have helped.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which of the following is an appropriate discourse marker for connecting two independent clauses?\",\n      \"options\": [\n        \"A) However,\",\n        \"B) But if.\",\n        \"C) Nevertheless,\",\n        \"D) Therefore.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which word is the best choice to complete the sentence: 'The new law will have a significant impact on the economy.'?\",\n      \"options\": [\n        \"A) intrusion\",\n        \"B) influencing\",\n        \"C) affecting\",\n        \"D) impactful\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which preposition is correct to fill in the blank: 'She lives \\_\\_ her parents.'?\",\n      \"options\": [\n        \"A) with\",\n        \"B) at\",\n        \"C) in\",\n        \"D) on\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which sentence is an example of reported speech?\",\n      \"options\": [\n        \"A) 'I think it's going to rain.' said John.\",\n        \"B) It was suggested that we should apply for the job.\",\n        \"C) The book is very interesting.\",\n        \"D) I will call you later.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which collocation is correct?\",\n      \"options\": [\n        \"A) take care of\",\n        \"B) put up with.\",\n        \"C) make out with.\",\n        \"D) get along with.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Which dependent prepositional phrase is correct?\",\n      \"options\": [\n        \"A) In the room where I work.\",\n        \"B) The book that he read last week.\",\n        \"C) About which we are discussing now.\",\n        \"D) To whom the letter was addressed.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which word best completes the sentence: 'He is always \\_\\_ his phone.'?\",\n      \"options\": [\n        \"A) on\",\n        \"B) with.\",\n        \"C) in.\",\n        \"D) at.\"\n      ],\n      \"answer\": \"B\"\n    }\n  ]\n}\n```",
