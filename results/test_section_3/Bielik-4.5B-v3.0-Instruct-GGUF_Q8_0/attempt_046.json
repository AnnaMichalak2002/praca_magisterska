  "raw_output": "{\n  \"exercis_typ\": \"CEFR Englisl Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is a correct way to express past conditional in reported speech?\",\n      \"options\": [\n        \"If she had gone, he would have met her.\",\n        \"He said that if I was there, they would be finished.\",\n        \"She told him that if it rained, we should stay home.\",\n        \"If she had known, he would have come.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Which of these sentences uses passive voice correctly?\",\n      \"options\": [\n        \"The book was written by a famous author.\",\n        \"She is reading the novel right now.\",\n        \"I have finished my homework.\",\n        \"The cake has been eaten.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Which of these expressions is an appropriate discourse marker for transitioning from one idea to another?\",\n      \"options\": [\n        \"As a result\",\n        \"However,\",\n        \"I am,\"\n        \"In order to\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which collocation is correct?\",\n      \"options\": [\n        \"take off\",\n        \"put away\",\n        \"set on fire\",\n        \"turn up\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which dependent preposition is used correctly in the following sentence?\",\n      \"options\": [\n        \"I am waiting for him to arrive.\",\n        \"She left her keys on the table.\",\n        \"The movie is played in the evenings.\",\n        \"He works at a restaurant.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which verb form is appropriate for the following sentence?\",\n      \"options\": [\n        \"I am going to travel around Europe.\",\n        \"She will be studying English next term.\",\n        \"They have already finished their work.\",\n        \"He was reading a book when I called.\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which of these sentences uses advanced conditional correctly?\",\n      \"options\": [\n        \"If I had known about it, I would have come.\",\n        \"She said that if he was here, they would be finished.\",\n        \"They think that if we work hard, we will succeed.\",\n        \"He claimed that if it rained, we should stay home.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which of these phrases is an appropriate way to express a hypothetical situation?\",\n      \"options\": [\n        \"If I were rich, I would buy a house.\",\n        \"She is going out with her friends tonight.\",\n        \"The cake was eaten by the children.\",\n        \"He has finished his homework.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Which of these sentences uses a precise lexical choice?\",\n      \"options\": [\n        \"I need to borrow some money.\",\n        \"She is planning to visit her grandparents this weekend.\",\n        \"They are expecting a new car next year.\",\n        \"He has received an invitation for the party.\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which of these sentences is grammatically correct?\",\n      \"options\": [\n        \"I am going to travel around Europe.\",\n        \"She will be studying English next term.\",\n        \"They have already finished their work.\",\n        \"He was reading a book when I called.\