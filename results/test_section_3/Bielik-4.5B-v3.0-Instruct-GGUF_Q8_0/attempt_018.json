  "raw_output": "{\n  \"exercis_type\": \"CEFR Englisl Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is an example of reported speech?\\nA) She said she was tired.\\nB) He told me that he would be late.\\nC) They think it will rain soon.\\nD) I believe they are going on vacation.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"What is the correct form of a passive voice sentence for 'The book was written by John'?\\nA) Who had written the book by John.\\nB) The book was written by John.\\nC) It was John who wrote the book.\\nD) By John, the book was written.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Choose the appropriate advanced conditional for 'If I had studied harder, I would have passed the exam.'\\nA) Present Simple \\- Study hard and pass the exam.\\nB) Past Perfect \\- Had studied and passed.\\nC) Present Perfect \\- Have studied and will pass.\\nD) Future Perfect \\- Will have passed.'\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which of these discourse markers is used to introduce a contrasting idea?\\nA) Therefore.\\nB) However.\\nC) Furthermore.\\nD) In addition.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which collocation is correct?\\nA) Bring up.\\nB) Take down.\\nC) Put away.\\nD) Leave off.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"What is the appropriate dependent preposition for 'I am waiting at home'?\\nA) in.\\nB) of.\\nC) with.\\nD) for.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which word is the most precise choice for 'The government has declared a state of emergency'?\\nA) announced.\\nB) proclaimed.\\nC) stated.\\nD) explained.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which of these is an appropriate use of a reported speech?\\nA) 'I think it will rain tomorrow.' said John.\\nB) I believe that he will be here soon.\\nC) They are going on vacation by plane.\\nD) We decided to stay at home.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Which sentence uses the passive voice correctly?\\nA) The cake was baked by my sister.\\nB) I saw him eating an apple.\\nC) She likes to read books on history.\\nD) They fixed the car last week.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which of the following is an example of a conditional type III?\\nA) If it were to rain, we would stay at home.\\nB) She will have finished her work by evening.\\nC) We should go there if time permits.\\nD) They could visit us when they are in town.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"A\"\n    }\n  ]\n}",
