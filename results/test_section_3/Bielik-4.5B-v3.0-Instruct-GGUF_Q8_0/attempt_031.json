  "raw_output": "{\n  \"exercis_typ\": \"CEFR Englisland Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is a correct translation of 'It was said that she had finished her homework.'?\",\n      \"options\": [\n        \"But he didn't say anything.\",\n        \"However, she claimed it was done.\",\n        \"It was said that she had finished her homework.\",\n        \"As a result, they decided to watch TV.\"\n      ],\n      \"answer\": \"It was said that she had finished her homework.\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Which of the following best completes 'If I \\_\\_\\_\\_ (be) more organized, I wouldn't have forgotten my keys.'?\",\n      \"options\": [\n        \"had been\",\n        \"were\",\n        \"am\",\n        \"been\"\n      ],\n      \"answer\": \"had been\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Which of the following is an appropriate use of a discourse marker to connect two sentences?\"\n      \"options\": [\n        \"As far as I know, she went to the cinema.\",\n        \"In fact, he isn't going anywhere.\",\n        \"I think it would be better if we stay home.\",\n        \"Actually, I believe she will change her mind.\"\n      ],\n      \"answer\": \"In fact\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which of the following is a correct use of collocation in this sentence: 'He \\_\\_\\_\\_ (spend) his weekends playing football.'?\",\n      \"options\": [\n        \"is spend\",\n        \"spends\",\n        \"has been spent\",\n        \"was spending\"\n      ],\n      \"answer\": \"spends\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which of the following is a correct use of dependent prepositions in this sentence: 'The book \\_\\_\\_\\_ (be) written by him.'?\",\n      \"options\": [\n        \"is\",\n        \"has been\",\n        \"was\",\n        \"with\"\n      ],\n      \"answer\": \"by\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which of the following is a correct translation of 'The computer \\_\\_\\_\\_ (be) repaired next week.'?\",\n      \"options\": [\n        \"is being\",\n        \"was being\",\n        \"will be\",\n        \"has been\"\n      ],\n      \"answer\": \"will be\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which of the following is a correct use of reported speech?\"\n      \"options\": [\n        \"She said she had finished her homework.\",\n        \"He claimed he was going to the cinema.\",\n        \"They decided they would watch TV.\",\n        \"It seems it is raining outside.\"\n      ],\n      \"answer\": \"She said she had finished her homework.\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which of the following is a correct use of passive voice in this sentence: 'The cake \\_\\_\\_\\_ (be) baked by her.'?\",\n      \"options\": [\n        \"is\",\n        \"was\",\n        \"has been\",\n        \"will be\"\n      ],\n      \"answer\": \"was\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Which of the following is an appropriate use of a discourse marker to connect two sentences?\"\n      \"options\": [\n        \"As far as I know, she went to the cinema.\",\n        \"In fact, he isn't going anywhere.\",\n        \"I think it would be better if we stay home.\",\n        \"Actually, I believe she will change her mind.\"\n      ],\n      \"answer\": \"In fact\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which of the following is a correct use of collocation in this sentence: 'The team \\_\\_\\_\\_ (win) their match.'?\",\n      \"options\": [\n        \"is winning\",\n        \"wins\",\n        \"has won\",\n        \"was winning\"\n     