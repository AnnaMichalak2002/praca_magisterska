  "raw_output": "{\n  \"exercis_typ\": \"CEFR English Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is a correct translation for 'It was said that she would arrive late'?\",\n      \"options\": [\n        \"A) She had been saying that she would be there early.\",\n        \"B) It was stated that she would depart soon.\",\n        \"C) He said that he might go to the party.\",\n        \"D) She was mentioned as arriving late.\"\n      ],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Which of the following sentences uses the passive voice correctly?\",\n      \"options\": [\n        \"A) The book was read by all students.\",\n        \"B) All students were reading the book.\",\n        \"C) The cake is cooking in the kitchen.\",\n        \"D) They are being served dinner.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"What is the correct form of the second conditional for 'If I had known about it, I would have called'?\",\n      \"options\": [\n        \"A) Had I known, I would call.\",\n        \"B) Known if I had, I would be calling.\",\n        \"C) If I were to have known, I would have called.\",\n        \"D) Had I known, I would have called.\"\n      ],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which of the following is an appropriate discourse marker to connect two sentences in a list?\",\n      \"options\": [\n        \"A) However,\",\n        \"B) Therefore,\",\n        \"C) Moreover,\",\n        \"D) Nevertheless.\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which of the following pairs is an example of a collocation?\",\n      \"options\": [\n        \"A) Asked for help.\",\n        \"B) Give up smoking.\",\n        \"C) Take a break.\",\n        \"D) Run out of time.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which of the following prepositions is correct to complete 'The book was written by him **'?\"',\n      \"options\": [\n        \"A) for\",\n        \"B) of\",\n        \"C) on\",\n        \"D) in.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which of the following phrases is an example of a precise lexical choice?\",\n      \"options\": [\n        \"A) He was very tired.\",\n        \"B) She felt quite unwell.\",\n        \"C) It rained heavily.\",\n        \"D) The weather turned out to be fair.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which of the following sentences uses a dependent prepositional phrase?\",\n      \"options\": [\n        \"A) I went to the store.\",\n        \"B) She is studying for her exams.\",\n        \"C) He lives in a big house on a hill.\",\n        \"D) They are watching TV.\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Which of the following is an incorrect form of reported speech?\",\n      \"options\": [\n        \"A) He said that he would call me.\",\n        \"B) She told him she was going on vacation.\",\n        \"C) They mentioned it might rain later.\",\n        \"D) We were informed the meeting has been cancelled.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which of the following sentences uses a non-standard English expression?\",\n      \"options\": [\n        \"A) I'm feeling fine.\",\n        \"B) He was driving too fast.\",\n        \"C) She had a nice time at the party.\",\n        \"D) They were going out for drinks.\"\n      ],\n      \"answer\": \"A\"\n    }