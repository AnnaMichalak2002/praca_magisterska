  "raw_output": "{\n  \"exercis_type\": \"CEFR Englis_Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of these is a correct form for 'I was told that he had finished his work'?\",\n      \"options\": [\n        \"A) He had finished his work was told.\",\n        \"B) That he had finished his work was told.\",\n        \"C) I was told that he has finished his work.\",\n        \"D) He had finished his work was being told.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Which of the following sentences uses the passive voice correctly?\",\n      \"options\": [\n        \"A) The cake was eaten by us.\",\n        \"B) We were driven to the station by our friend.\",\n        \"C) A message has been sent to you.\",\n        \"D) The book was read in two days.\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Choose the correct form of 'If I had studied harder' for expressing wish.\",\n      \"options\": [\n        \"A) I would have studied more.\",\n        \"B) I was to study hard.\",\n        \"C) Had I studied harder.\",\n        \"D) Studying had been easier.\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which of these sentences uses discourse markers appropriately?\",\n      \"options\": [\n        \"A) She is tall and she has a beautiful voice.\",\n        \"B) The cat scratched the dog, which was playing in the garden.\",\n        \"C) I went to the shops; they were closed.\",\n        \"D) He is a good student because he works hard.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which collocation is correct?\",\n      \"options\": [\n        \"A) A shirt of white.\",\n        \"B) The books are on the shelf's.\",\n        \"C) I am afraid to go there.\",\n        \"D) He is interested in music.\"\n      ],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which of these sentences uses a dependent preposition correctly?\",\n      \"options\": [\n        \"A) I live in London.\",\n        \"B) She is writing an essay about the war's causes.\",\n        \"C) The book was read by us yesterday.\",\n        \"D) I have a meeting at nine o'clock.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which of the following is a more precise lexical choice?\",\n      \"options\": [\n        \"A) He was born in London.\",\n        \"B) She has lived here for ten years.\",\n        \"C) The cat is sleeping on the sofa.\",\n        \"D) I have a phone number.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which sentence uses reported speech correctly?\",\n      \"options\": [\n        \"A) She said she had finished her homework.\",\n        \"B) He told me that he has finished his work.\",\n        \"C) They suggested we go for a walk.\",\n        \"D) She said they had been there before.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Which of these sentences is grammatically correct?\",\n      \"options\": [\n        \"A) The book was read by us in two days.\",\n        \"B) She has been living here since last year.\",\n        \"C) I have a meeting at nine o'clock tomorrow.\",\n        \"D) They were driven by their friend to the station.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which sentence uses a subordinating conjunction correctly?\",\n      \"options\": [\n        \"A) I went to the shops; they were closed.\",\n        \"B) She is writing an essay about the w