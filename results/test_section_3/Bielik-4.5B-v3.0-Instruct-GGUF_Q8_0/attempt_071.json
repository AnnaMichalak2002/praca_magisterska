er\": \"C\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which dependent preposition is appropriate for this sentence? 'I will call you when I have finished.'\"\n      ,\n      \"options\": [\n        \"A) as\",\n        \"B) since\",\n        \"C) until\",\n        \"D) after\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which precise lexical choice is correct? 'She was ______.'\"\n      ,\n      \"options\": [\n        \"A) tired\",\n        \"B) exhausted\",\n        \"C) sleepy\",\n        \"D) drowsy\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which reported speech is correct? 'She said that she would come if I invite her.'\"\n      ,\n      \"options\": [\n        \"A) She said that she would come because I invited her.\",\n        \"B) She said that if I had invited her, she would have come.\",\n        \"C) She said that I should invite her to the party.\",\n        \"D) She said that she was going to come when I asked her.\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Which form of the passive voice is correct for this sentence? 'The cake was baked by my sister.'\"\n      ,\n      \"options\": [\n        \"A) The cake had been baked\",\n        \"B) Baked the cake was\",\n        \"C) My sister has baked the cake\",\n        \"D) The cake is being baked\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which discourse marker best connects the two sentences? 'They went to the park. ______.'\"\n      ,\n      \"options\": [\n        \"A) Therefore\",\n        \"B) However\",\n        \"C) Besides\",\n        \"D) Thus\"\n      ],\n      \"answer\": \"A\"\n    }\n}\n```",
