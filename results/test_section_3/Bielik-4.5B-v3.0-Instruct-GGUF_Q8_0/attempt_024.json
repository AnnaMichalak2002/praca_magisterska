  "raw_output": "{\n  \"exercis_typ\": \"CEFR English Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is a correct translation for 'It was suggested that we should bring extra pens'?\",\n      \"options\": [\n        \"A) It was advised to us bring more pens.\",\n        \"B) It was suggested that we brought the extra pens.\",\n        \"C) We should have been asked about bringing extra pens.\",\n        \"D) Suggestion was made to us to bring more pens.\"\n      ],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Which form of the passive voice is used in 'The book was written by a famous author'?\",\n      \"options\": [\n        \"A) Present perfect\",\n        \"B) Past simple\",\n        \"C) Present continuous\",\n        \"D) Past perfect\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Which of the following is an incorrect use of advanced conditionals?\",\n      \"options\": [\n        \"A) If she had studied harder, she would have passed the exam.\",\n        \"B) Had we known about it earlier, we could have avoided the conflict.\",\n        \"C) She will be happy if I call her now.\",\n        \"D) They would have arrived on time if there had been no traffic.\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which of the following is an example of a discourse marker used to introduce a reason?\",\n      \"options\": [\n        \"A) As\",\n        \"B) But\",\n        \"C) Yet\",\n        \"D) Therefore\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which collocation is incorrect?\",\n      \"options\": [\n        \"A) on time\",\n        \"B) off-duty\",\n       