  "raw_output": "{\n  \"exercis_typ\": \"CEFR Englis_Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is a correct translation for 'It was said that he had finished his homework'?\",\n      \"options\": [\n        \"A) He has finished his homework was said.\",\n        \"B) His homework had been finished was stated.\",\n        \"C) Had he finished his homework was reported.\",\n        \"D) He had finished his homework was said.\"\n      ],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Which form of the passive voice is used in 'The cake was baked by my sister'?\",\n      \"options\": [\n        \"A) Past Perfect\",\n        \"B) Present Perfect\",\n        \"C) Past Continuous\",\n        \"D) Present Simple\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Which conditional sentence is incorrect?\",\n      \"options\": [\n        \"A) If it were raining tomorrow, we would stay at home.\",\n        \"B) She will be surprised if you call her now.\",\n        \"C) He should have finished his project before the deadline.\",\n        \"D) They would have arrived earlier if they had taken a bus.\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which of the following is an appropriate use of a discourse marker in reported speech?\",\n      \"options\": [\n        \"A) He said, 'It was great.'\",\n        \"B) She told me that she had finished her work.\",\n        \"C) They suggested that we should go for a walk.\",\n        \"D) He said, 'It's important.'\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which collocation is incorrect?\",\n      \"options\": [\n        \"A) put off a deadline\",\n        \"B) cut down on expenses\",\n        \"C) throw out the baby with the bathwater\",\n        \"D) break up with someone\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which dependent preposition is used in 'I don't want to go out because it's raining'?\",\n      \"options\": [\n        \"A) as\",\n        \"B) since\",\n        \"C) while\",\n        \"D) because\"\n      ],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which word choice is more precise in 'The experiment was conducted by the team'?\",\n      \"options\": [\n        \"A) performed\",\n        \"B) carried out\",\n        \"C) executed\",\n        \"D) implemented\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which grammatical construction is used in 'It's been said that the new policy will be implemented next month.'?\",\n      \"options\": [\n        \"A) Subjunctive\",\n        \"B) Passive voice\",\n        \"C) Infinitive\",\n        \"D) Present Perfect\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Which phrase is an appropriate way to express 'The document was reviewed by the committee'?\",\n      \"options\": [\n        \"A) The committee had reviewed the document.\",\n        \"B) It is being reviewed by the committee.\",\n        \"C) The document was been reviewed by them.\",\n        \"D) They had reviewed the document.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which word is the correct form of 'to be' in reported speech?\",\n      \"options\": [\n        \"A) was\",\n        \"B) were\",\n        \"C) is\",\n        \"D) are\"\n      ],\n      \"answer\": \"A\"\n    }\n]",
