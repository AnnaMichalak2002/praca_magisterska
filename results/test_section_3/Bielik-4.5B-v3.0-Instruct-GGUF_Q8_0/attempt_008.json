  "raw_output": "{\n  \"exercis_typ\": \"CEFR Englisland Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is a correct translation of 'It was suggested that we should go to the cinema' into reported speech?\",\n      \"options\": [\n        \"A) They were advised by me to watch a movie.\",\n        \"B) It was suggested that we should go out with friends.\",\n        \"C) I was instructed to take everyone to the cinema.\",\n        \"D) We were recommended by someone to see a film.\"\n      ],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Which of the following phrases is an appropriate use of the passive voice?\",\n      \"options\": [\n        \"A) The cake was baked by my mother.\",\n        \"B) I wrote a letter to my friend.\",\n        \"C) A crime has been committed in the city centre.\",\n        \"D) The book was read by many people.\"\n      ],\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Which of the following conditionals is correct for expressing a hypothetical situation?\",\n      \"options\": [\n        \"A) If you had studied harder, you would have passed the exam.\",\n        \"B) If she were richer, she would buy a new car.\",\n        \"C) When he was younger, he played football regularly.\",\n        \"D) As soon as they arrived, the party started.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which of the following discourse markers is used to introduce a new idea?\",\n      \"options\": [\n        \"A) however\",\n        \"B) because\",\n        \"C) as if\",\n        \"D) in addition\"\n      ],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which of the following collocations is correct?\",\n      \"options\": [\n        \"A) keep an eye on\",\n        \"B) put a feet in\",\n        \"C) make up mind\",\n        \"D) take off clothes\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which of the following prepositions is used to indicate a dependent relationship?\",\n      \"options\": [\n        \"A) for\",\n        \"B) with\",\n        \"C) of\",\n        \"D) about\"\n      ],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which of the following phrases is an appropriate use of a precise lexical choice?\",\n      \"options\": [\n        \"A) I'm feeling terrible today.\",\n        \"B) She is very busy at the moment.\",\n        \"C) He was quite angry when he saw his results.\",\n        \"D) The book has been out of print for years.\"\n      ],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which of the following phrases is an appropriate use of a discourse marker to connect two ideas?\",\n      \"options\": [\n        \"A) however\",\n        \"B) because\",\n        \"C) as if\",\n        \"D) in addition\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Which of the following conditionals is correct for expressing a hypothetical situation where both subjects are passive?\",\n      \"options\": [\n        \"A) If they were working hard, it would be done.\",\n        \"B) When he was younger, he played football regularly.\",\n        \"C) As soon as we arrived, the party started.\",\n        \"D) If they had studied harder, it would have been completed.\"\n      ],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which of the following phrases is an appropriate use of a precise lexical choice to describe a situation?\",\n      \"options\": [\n        \"A) I'm feeling terrible today.\",\n        \"B) She is very busy at the moment.\",\n        \"C) He was quite angry when he saw his results.\",\n        \"D) The book has been out of print for years.\"\n      ],\n      \"answer\": \"A\"\n    }\n}",
