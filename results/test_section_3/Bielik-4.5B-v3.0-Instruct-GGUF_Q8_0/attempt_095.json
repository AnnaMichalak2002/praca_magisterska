  "raw_output": "{\n  \"exercis_typ\": \"CEFR Englisland Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of these is an example of reported speech? \\nA) She said she was going to visit her friend. \\nB) He suggested that we should change our plans. \\nC) They were talking about their holidays.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Choose the correct form of the passive voice for this sentence: \\n\\\"The company hired a new manager.\\\" \\nA) A new manager was hired by the company. \\nB) The company hired a new management. \\nC) A new manager is being hired in the company.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Which advanced conditional is used in this sentence? \\n\\\"If I had studied harder, I would have passed the exam.\\\" \\nA) Present Simple + would have done \\nB) Past Perfect + would have done \\nC) Present Perfect + would have done.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which discourse marker should be used to connect the two sentences? \\n\\\"It was a very busy day. I had no time for relaxation.\\\" \\nA) However, B) Moreover, C) Nevertheless.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which collocation is incorrect? \\nA) put off (a date), B) take over (a job), C) give up (an exam).\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which dependent preposition is used in this sentence? \\n\\\"I will call you when I get back home.\\\" \\nA) for, B) after, C) on.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which precise lexical choice is appropriate? \\n\\\"I need to book a ticket for the train. I can't afford to waste time on public transportation.\\\" \\nA) book, B) spend, C) take.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which of these phrases is an idiom? \\nA) give up on someone, B) put away your books, C) make out with someone.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Which expression is incorrect? \\n\\\"It's a good idea. I think you should do it now.\\\" \\nA) It seems like a good idea. B) That sounds like a good idea. C) You might want to try that.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"C\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which grammatical construction is used in this sentence? \\n\\\"They were told that the meeting would be postponed.\\\" \\nA) Past Perfect + was/were done, B) Present Simple + will be, C) Present Simple + is being.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D]\",\n      \"answer\": \"A\"\n    }\n  ]\n}",
