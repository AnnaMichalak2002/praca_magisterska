  "raw_output": "{\n  \"exercis_typ\": \"CEFR Englis_Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"Which of the following is an example of reported speech? \\nA) She said she would go to the party.\\nB) He claimed he had finished his work.\\nC) They suggested we should meet next week.\\nD) We were informed that there was a change in plans.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"Which sentence uses the passive voice correctly? \\nA) The cake was baked by my sister.\\nB) I am writing a letter today.\\nC) She likes reading books.\\nD) They will be playing football at 3 PM.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"Choose the appropriate advanced conditional for this sentence: \\nIf I had studied harder, I would have passed the exam.\\nA) Present Simple/Present Perfect\\nB) Past Simple/Past Perfect\\nC) Present Perfect/Past Perfect\\nD) Present Simple/Past Perfect.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"Which discourse marker best connects the two sentences? \\nI don't think I can finish this task. \\_\\_\\_ I will need to ask for help.\\nA) Nevertheless\\nB) However\\nC) Therefore\\nD) Moreover.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"B\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"Which collocation is correct? \\nA) put up with\\nB) take off from\\nC) give over to\\nD) send out for.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"Which dependent preposition is used in the sentence? \\nI will call you when I arrive.\\nA) after\\nB) because\\nC) since\\nD) when.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"D\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"Which word is more precise in the context? \\nA) awkward\\nB) annoying\\nC) difficult\\nD) frustrating.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"Which verb tense is used in the sentence? \\nIt was suggested that we should change our plans.\\nA) Past Simple\\nB) Present Perfect\\nC) Future Perfect\\nD) Present Continuous.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"Which word is the most appropriate in this context? \\nIt's important that we \\_\\_\\_ our responsibilities.\\nA) fulfill\\nB) perform\\nC) execute\\nD) carry out.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"A\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"Which word is a more precise synonym for 'appreciate'? \\nA) admire\\nB) approve\\nC) value\\nD) enjoy.\",\n      \"options\": [\"A\", \"B\", \"C\", \"D\"],\n      \"answer\": \"C\"\n    }\n  ]\n}",
