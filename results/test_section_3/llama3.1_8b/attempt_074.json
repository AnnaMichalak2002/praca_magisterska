  "raw_output": "{\n  \"exercise_type\": \"CEFR English Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"She said to me, 'I've been waiting for you.' What is the reported speech in this sentence?\",\n      \"options\": [\"I have been waiting for you\", \"I was waiting for you\", \"I'm waiting for you now\", \"I will wait for you\"],\n      \"answer\": \"I was waiting for you\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"The new policy has been implemented by the company to reduce waste and increase efficiency.\",\n      \"question\": \"What form of the verb 'implement' is used in this sentence?\",\n      \"options\": [\"implemented\", \"is implementing\", \"has been implementing\", \"will implement\"],\n      \"answer\": \"has been implementing\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"If I had studied harder, I would have passed the exam.\",\n      \"question\": \"What type of conditional is used in this sentence?\",\n      \"options\": [\"zero\", \"first\", \"second\", \"third\"],\n      \"answer\": \"third\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"The manager suggested that we should consider the environmental impact of our actions.\",\n      \"question\": \"What discourse marker is used in this sentence?\",\n      \"options\": [\"however\", \"in addition to\", \"nevertheless\", \"considering\"],\n      \"answer\": \"considering\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"The company's profits have risen significantly since the new strategy was introduced.\",\n      \"question\": \"What form of the verb 'introduce' is used in this sentence?\",\n      \"options\": [\"has been introducing\", \"was introducing\", \"is introducing\", \"had introduced\"],\n      \"answer\": \"had introduced\"\n    },\n  