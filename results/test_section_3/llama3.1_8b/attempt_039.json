  "raw_output": "{\n  \"exercise_type\": \"CEFR English Placement Test\",\n  \"section_id\": 3,\n  \"section_title\": \"Grammar and Vocabulary (B2)\",\n  \"cefr_range\": \"B2\",\n  \"questions\": [\n    {\n      \"question_number\": 21,\n      \"question\": \"He said, 'I'm going to the supermarket.' What is a more formal way of reporting this?\",\n      \"options\": [\"He told me he was going to the supermarket.\", \"He said that he was going to the supermarket.\", \"He mentioned he had to go to the supermarket.\", \"He claimed he would be shopping at the supermarket.\"],\n      \"answer\": \"He said that he was going to the supermarket.\"\n    },\n    {\n      \"question_number\": 22,\n      \"question\": \"The new policy will be implemented next month. What is the passive form of this sentence?\",\n      \"options\": [\"The implementation of the new policy will be done next month.\", \"A new policy will be implemented next month.\", \"The new policy has been implemented already.\", \"Next month, a new policy will be introduced.\"],\n      \"answer\": \"The implementation of the new policy will be done next month.\"\n    },\n    {\n      \"question_number\": 23,\n      \"question\": \"If I had studied harder, I would have passed the exam. What is the correct form of this sentence in the third conditional?\",\n      \"options\": [\"I would study hard if I had passed the exam.\", \"Had I studied harder, I would pass the exam.\", \"If I had studied harder, I would have been able to pass the exam.\", \"I would have passed the exam if I had studied harder.\"],\n      \"answer\": \"If I had studied harder, I would have been able to pass the exam.\"\n    },\n    {\n      \"question_number\": 24,\n      \"question\": \"The manager was not pleased with the team's performance. What discourse marker is most suitable in this context?\",\n      \"options\": [\"However, the team did their best.\", \"In fact, they worked very hard.\", \"Meanwhile, the sales figures were disappointing.\", \"As a result, the manager fired the coach.\"],\n      \"answer\": \"However, the team did their best.\"\n    },\n    {\n      \"question_number\": 25,\n      \"question\": \"The new employee was struggling to keep up with the workload. What collocation is most suitable in this context?\",\n      \"options\": [\"He was overwhelmed by the amount of work.\", \"She was burdened with too many tasks.\", \"They were swamped with paperwork.\", \"He was bogged down with administrative duties.\"],\n      \"answer\": \"He was overwhelmed by the amount of work.\"\n    },\n    {\n      \"question_number\": 26,\n      \"question\": \"The company has been facing financial difficulties. What is the correct form of this sentence in the passive voice?\",\n      \"options\": [\"Financial difficulties have faced the company.\", \"The company faces financial difficulties.\", \"The company has been facing financial difficulties.\", \"Financial difficulties are being faced by the company.\"],\n      \"answer\": \"The company has been facing financial difficulties.\"\n    },\n    {\n      \"question_number\": 27,\n      \"question\": \"If it rains tomorrow, we won't be able to go to the beach. What is the correct form of this sentence in the first conditional?\",\n      \"options\": [\"It will rain tomorrow and we won't go to the beach.\", \"We won't go to the beach if it rains tomorrow.\", \"If it rains tomorrow, we'll have to stay at home.\", \"Tomorrow, we won't be able to go to the beach if it rains.\"],\n      \"answer\": \"We won't go to the beach if it rains tomorrow.\"\n    },\n    {\n      \"question_number\": 28,\n      \"question\": \"The manager was very pleased with the team's performance. What is a more formal way of expressing this?\",\n      \"options\": [\"The manager was delighted with the team's performance.\", \"He was impressed by their hard work.\", \"She was satisfied with the results.\", \"They were thrilled to hear about the success.\"],\n      \"answer\": \"The manager was delighted with the team's performance.\"\n    },\n    {\n      \"question_number\": 29,\n      \"question\": \"The company has decided to invest in new technology. What is the correct form of this sentence in the passive voice?\",\n      \"options\": [\"New technology has been invested in by the company.\", \"The company has invested in new technology.\", \"Investment in new technology has been made by the company.\", \"The company is investing in new technology.\"],\n      \"answer\": \"The company has invested in new technology.\"\n    },\n    {\n      \"question_number\": 30,\n      \"question\": \"If I had more time, I would have finished the project. What is the correct form of this sentence in the third conditional?\",\n      \"options\": [\"I would finish the project if I had more time.\", \"Had I had more time, I would have finished the project.\", \"If I had more time, I would be able to finish the project.\", \"I would have been able to finish the project if I had more time.\"],\n      \"answer\": \"Had I had more time, I would have finished the project.\"\n  ]\n}",
